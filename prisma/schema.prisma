// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// 1. SYSTEM CONFIG & MASTER DATA
// ==========================================

// 🌟 สร้างตาราง User แยกออกมาสำหรับระบบ Login โดยเฉพาะ
model User {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String?   @unique
  passwordHash String
  role         String    @default("USER") // ADMIN หรือ USER
  isActive     Boolean   @default(true)
  
  // ความสัมพันธ์ไปหา Employee (1-to-1)
  // ⚠️ เป็น optional — บัญชีฝั่ง Asset จะไม่มี Employee ผูก (ไม่ใช่พนักงานในระบบ payroll)
  employee     Employee?

  // 🌟 [asset_redesign] บริษัทฝั่ง asset ที่ user คนนี้เข้าถึงได้
  assetMemberships AssetCompanyMember[]

  createdAt    DateTime  @default(now())
}

model Company {
  id           Int       @id @default(autoincrement())
  companyCode  String    @unique
  companyName  String
  logoUrl      String?   // (ใส่ ? แปลว่าไม่มีก็ได้)

  // 🌟 [Phase 2 - Asset] เพิ่มตาม requirement doc หน้าจอทะเบียนบริษัท
  address      String?   // ที่อยู่
  description  String?   // รายละเอียด
  // periodEndDate ถูกตัดออกแล้ว (phase2asset_#15) — งวดบัญชีสำหรับคำนวณค่าเสื่อมราคายึด 31 ธ.ค. เสมอทุกบริษัท ไม่ให้ตั้งเองต่อบริษัทอีกต่อไป
  preparedBy   String?   // ผู้จัดทำ (auto display จาก user ที่สร้าง/แก้ไขล่าสุด)

  // 🌟 [Phase 2 - Asset / bug_ลบ company] สถานะ Terminate (soft-deactivate)
  isActive       Boolean   @default(true)
  terminatedAt   DateTime?
  terminateReason String?

  parentId     Int?
  parent       Company?  @relation("CompanyHierarchy", fields: [parentId], references: [id])
  subCompanies Company[] @relation("CompanyHierarchy")

  employees    Employee[]
  payrolls     Payroll[]

  importBatches PayrollImportBatch[]
  assets        Asset[]

  // 🌟 [module_company] module ที่บริษัทนี้เปิดใช้งาน (Payroll / Assessment) — คุมจากหน้า Company Management
  moduleLinks   CompanyModule[]

  // 🌟 [asset_redesign] บริษัทนี้ถูกสร้างจากฝั่งไหน "PAYROLL" (หน้า Company Management เดิม)
  // หรือ "ASSET" (asset user สร้างเองจากโซน /asset) — ใช้แยกที่มาของข้อมูล ไม่ได้ใช้คุมสิทธิ์โดยตรง
  origin        String    @default("PAYROLL")

  // 🌟 [asset_redesign] สมาชิกฝั่ง asset — ใครเข้าถึงทรัพย์สินของบริษัทนี้ได้บ้าง
  assetMembers  AssetCompanyMember[]
}

// 🌟 [asset_redesign] ใครเข้าถึงบริษัทไหนได้บ้างในโมดูล Asset
//
// สิทธิ์เข้าถึงทรัพย์สินของบริษัทหนึ่ง ต้องผ่าน 2 ชั้นพร้อมกัน:
//   1. บริษัทนั้นติ๊ก module Assessment ไว้ (CompanyModule) = บริษัทซื้อบริการแล้ว
//   2. user มีแถวใน AssetCompanyMember = คนนี้ได้รับสิทธิ์เข้าถึง
// ADMIN ข้ามทั้งสองชั้น เห็นและแก้ไขได้ทุกบริษัทเสมอ
//
// ⚠️ userId ตั้งใจให้เป็น optional + SetNull (ไม่ใช่ Cascade) เพราะตามที่ตกลงไว้
// ถ้าลบ user เจ้าของทิ้ง ข้อมูลบริษัท/ทรัพย์สินต้องค้างอยู่ ไม่หายตามไปด้วย
// ระบบจะแสดงเป็น "ไม่มีเจ้าของ" แล้วให้ admin โอนเจ้าของให้คนใหม่แทน
model AssetCompanyMember {
  id        Int      @id @default(autoincrement())

  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  companyId Int
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  isOwner   Boolean  @default(false) // คนสร้างบริษัทนี้ (โอนให้คนอื่นได้)
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
}

// ==========================================
// 4. FIXED ASSET REGISTER (Phase 2)
// ==========================================

// 🌟 ประเภททรัพย์สิน — master data แก้ไขได้ผ่านหน้า Settings (ตอบคำถาม phase2asset_#27 แล้ว: "แก้ไขได้")
model AssetCategory {
  id     Int     @id @default(autoincrement())
  name   String  @unique // เครื่องใช้สำนักงาน, เครื่องจักรและอุปกรณ์, ยานพาหนะ, อาคาร
  assets Asset[]
}

// 🌟 ประเภทการคำนวณค่าเสื่อมราคา — master data ที่แก้ได้ทั้งชื่อและ "การคำนวณ" จริง
// โดยแก้ conditionType/formulaType ได้ (เลือกจาก vocab คงที่ที่ engine รองรับ ไม่ใช่พิมพ์สูตรอิสระ
// เพื่อความปลอดภัยของตัวเลขทางบัญชี) ดู evaluator จริงใน src/lib/depreciation.ts
model DepreciationCalcType {
  id                    Int      @id @default(autoincrement())
  code                  String   @unique // slug ที่ admin ตั้งเอง เช่น PURCHASED_DURING_PERIOD (ไม่ผูกกับ engine โดยตรงอีกต่อไป)
  label                 String   // ชื่อที่แสดงในรายงาน แก้ไขได้

  // เงื่อนไขที่ต้องเข้าเงื่อนไขนี้ก่อนถึงจะใช้ formulaType คำนวณ (เลือกจาก CONDITION_TYPES ใน depreciation.ts)
  conditionType         String
  // คำอธิบายเงื่อนไขแบบข้อความ ใช้แสดงในรายละเอียดรายงาน (เอา condition มาโชว์ตามที่ขอ)
  conditionDescription  String

  // สูตรที่ใช้คำนวณค่าเสื่อมของงวด เมื่อ matched เงื่อนไขข้างบน (เลือกจาก FORMULA_TYPES ใน depreciation.ts)
  formulaType           String

  sortOrder             Int      @default(0) // ลำดับการตรวจเงื่อนไข (ตรวจจากน้อยไปมาก matched ตัวแรกใช้เลย)
  isActive              Boolean  @default(true)
  isDefault             Boolean  @default(false) // แถว fallback เมื่อไม่ match เงื่อนไขอื่นเลย — ลบไม่ได้ ต้องมีอย่างน้อย 1 แถวเสมอ
}

model Asset {
  id                 String        @id @default(cuid())
  assetCode          String        @unique // รหัสทรัพย์สิน เช่น A001

  companyId          Int
  company            Company       @relation(fields: [companyId], references: [id])

  categoryId         Int
  category           AssetCategory @relation(fields: [categoryId], references: [id])

  description        String        // รายละเอียดทรัพย์สิน
  location           String?       // 🌟 ที่ตั้งทรัพย์สิน (จุดที่ขาดไปในดีไซน์รอบแรก)

  cost               Decimal       // ราคาทุน/ราคาทรัพย์สิน
  depreciationRate   Decimal       // อัตราค่าเสื่อมราคาต่อปี เช่น 0.20 = 20%/ปี
  purchaseDate       DateTime      // วันที่ซื้อ

  // 🌟 [phase2asset_#15] ยอดยกมาแบบ manual — สำหรับทรัพย์สินเก่าที่มีอยู่ก่อนเข้าระบบนี้ (เสื่อมมาแล้วบางส่วน)
  // ถ้าตั้งค่าไว้ engine จะใช้ค่านี้เป็นฐานแทนการคำนวณจาก purchaseDate ตรงๆ (ดู src/lib/depreciation.ts)
  openingAccumDepr   Decimal?      // ค่าเสื่อมสะสม ณ วันที่ openingAsOfDate
  openingAsOfDate    DateTime?     // วันที่ของยอดยกมาข้างต้น (ปกติคือ 31 ธ.ค. ของปีก่อนเริ่มใช้ระบบ)

  yearlyCloses       AssetYearlyClose[]

  // 🌟 [phase2asset #17] สถานะ Terminate (soft-deactivate)
  isActive           Boolean       @default(true)
  terminatedAt       DateTime?
  terminateReason    String?

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

// 🌟 [phase2asset_#15] ประวัติการปิดงวดค่าเสื่อมราคารายปี — ปิดอัตโนมัติเมื่อมีคนเข้าหน้า Asset
// Register/Report และเจอปีที่ผ่านไปแล้ว (31 ธ.ค. ผ่านมาแล้ว) แต่ยังไม่เคยปิด บันทึกไว้ถาวร แก้ไม่ได้
model AssetYearlyClose {
  id                     Int      @id @default(autoincrement())
  assetId                String
  asset                  Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  year                   Int      // ปีที่ปิดงวด (ปฏิทิน 1 ม.ค. - 31 ธ.ค.)
  accumDeprBF            Decimal
  depreciationForYear    Decimal
  accumDeprCF            Decimal
  nbv                    Decimal
  calcTypeLabel          String   // เก็บ snapshot label ไว้ ณ ตอนปิดงวด (เผื่อ master data ถูกแก้ทีหลัง)

  closedAt               DateTime @default(now())
  closedBy               String   // "SYSTEM (Auto)" เสมอตอนนี้ เพราะไม่มี manual close

  @@unique([assetId, year])
}

// 🌟 [phase2asset_#16] ตั้งค่าการแจ้งเตือนของโมดูล Asset — singleton row เดียว
model AssetModuleSettings {
  id                    Int @id @default(1)
  nearExpiryWarningDays Int @default(0) // 0 = ปิดการแจ้งเตือนใกล้หมดอายุ (ค่าเริ่มต้นตามที่ user ตอบ)
}

model Employee {
  id               String    @id
  fullName         String
  email            String?   // อีเมลสำหรับติดต่อทั่วไป
  position         String?
  department       String?
  startDate        DateTime?
  isActive         Boolean   @default(true)
  bank             String?   
  bankAccount      String?
  
  userId           String?   @unique
  user             User?     @relation(fields: [userId], references: [id])
  
  currentCompanyId Int
  company          Company   @relation(fields: [currentCompanyId], references: [id])
  
  payrolls         Payroll[]
}
// ==========================================
// 2. PRODUCTION PAYROLL DATA
// ==========================================

model Payroll {
  id              Int           @id @default(autoincrement())
  month           Int
  year            Int

  totalEarnings   Decimal       @default(0.00)
  totalDeductions Decimal       @default(0.00)
  netSalary       Decimal       @default(0.00)
  grossWage       Decimal       @default(0.00)
  
  // ปรับให้สอดคล้องกับรายละเอียดใหม่
  salary          Decimal       @default(0.00)
  tax             Decimal       @default(0.00)
  sso             Decimal       @default(0.00)
  pvf             Decimal       @default(0.00)

  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id])
  
  companyId       Int
  company         Company       @relation(fields: [companyId], references: [id])
  
  items           PayrollItem[] 
  createdAt       DateTime      @default(now())
}

model PayrollItem {
  id          Int      @id @default(autoincrement())
  itemType    String   
  category    String   
  description String?  
  amount      Decimal  @default(0.00)

  payrollId   Int
  payroll     Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
}

// ==========================================
// 3. STAGING (IMPORT EXCEL DATA)
// ==========================================

model PayrollImportBatch {
  id             String                @id @default(uuid())
  fileName       String    
  month          Int
  year           Int
  companyId      Int  
  // 🌟 2. เพิ่มบรรทัดนี้เข้าไปครับ:
  company        Company               @relation(fields: [companyId], references: [id])
                   
  paymentDate    String?               // 🌟 2. เพิ่มฟิลด์ paymentdate (เก็บเป็น String เพื่อง่ายต่อการรับค่าจากฟอร์ม)
  
  totalRecords   Int                   @default(0)
  readyRecords   Int                   @default(0)
  failedRecords  Int                   @default(0)
  
  status         String                @default("PENDING") 
  uploadedById   String                
  createdAt      DateTime              @default(now())
  
  records        PayrollImportRecord[]
}

model PayrollImportRecord {
  id                        Int                @id @default(autoincrement())
  batchId                   String
  batch                     PayrollImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  
  rowNumber                 Int                

  // --- ข้อมูลพนักงาน (Employee Info) ---
  employeeId                String?            
  name                      String?            
  position                  String?            
  department                String?            
  function                  String?            
  startDate                 String?            
  bank                      String?            
  bankAccount               String?            

  // 🌟 3. ปรับหมวดรายรับ (Earnings) ตามที่ระบุ
  salary                    Decimal            @default(0.00) 
  mobileAllowance           Decimal            @default(0.00) 
  housingTravelingAllowance Decimal            @default(0.00) 
  overtime                  Decimal            @default(0.00) 
  bonus                     Decimal            @default(0.00) 
  others                    Decimal            @default(0.00) 
  parkingAllowance          Decimal            @default(0.00) 
  perdiemOtherAdditional    Decimal            @default(0.00) 
  
  totalEarnings             Decimal            @default(0.00) 

  // 🌟 4. ปรับหมวดรายจ่าย (Deductions) ตามที่ระบุ
  tax                       Decimal            @default(0.00) 
  socialSecurityFund        Decimal            @default(0.00) 
  providentFund             Decimal            @default(0.00) 
  studentLoanFund           Decimal            @default(0.00) 
  parking                   Decimal            @default(0.00) 
  otherDeduction            Decimal            @default(0.00) 
  
  totalDeduction            Decimal            @default(0.00) 

  // --- สรุปยอด (Summary) ---
  totalAmount               Decimal            @default(0.00) 
  payrollAmount             Decimal            @default(0.00) 

  status                    String             @default("READY") 
  errorMessage              String?            

  createdAt                 DateTime           @default(now())
}
// จำลองตารางเก็บประวัติการนำเข้าไฟล์เงินเดือน
model ImportLog {
  id           Int      @id @default(autoincrement())
  importDate   DateTime @default(now()) // วันเวลาที่กด Import
  filename     String   // ชื่อไฟล์ที่อัปโหลด
  importedBy   String   // ชื่อคนที่อัปโหลด (Admin)
  totalRecords Int      // จำนวนข้อมูลทั้งหมดในไฟล์
  successCount Int      // จำนวนที่เข้าสำเร็จ
  errorCount   Int      // จำนวนที่ Error
  status       String   // สถานะ: SUCCESS, PARTIAL, FAILED
}

// ==========================================
// 5. RBAC — Module & Role Access (แทน allowedRoles hardcode ในโค้ด)
// ==========================================

// 🌟 "Module" คือหมวดหมู่เมนูใหญ่ (เช่น HR, ASSET) ใช้จัดกลุ่ม sidebar + คุมสิทธิ์เข้าถึงเป็นกลุ่ม
model Module {
  id          Int                @id @default(autoincrement())
  code        String             @unique // "HR", "ASSET" — ใช้ผูกกับ moduleCode ของแต่ละเมนูในโค้ด (layout.tsx)
  name        String             // ชื่อที่แสดง เช่น "Payroll", "Assessment"
  sortOrder   Int                @default(0)
  access      RoleModuleAccess[]

  // 🌟 [module_company] บริษัทที่เปิดใช้ module นี้
  companyLinks CompanyModule[]
}

// 🌟 [module_company] บริษัทไหนเปิดใช้ module ไหนบ้าง (many-to-many)
// ใช้คุมว่า user ของบริษัทนั้นจะเห็นเมนู/ฟังก์ชันของ module ใดได้บ้าง
// ถ้าบริษัทเปิดทั้ง 2 module ก็เห็นทั้งหมด
model CompanyModule {
  id        Int     @id @default(autoincrement())
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  moduleId  Int
  module    Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([companyId, moduleId])
}

// 🌟 กำหนดว่า role ไหนเข้า module ไหนได้บ้าง (many-to-many ผ่านตารางนี้)
// role เป็น String ตรงกับ User.role (ADMIN/HR/USER/ASSET) — ไม่ทำ FK เพราะ role เดิมเก็บเป็น string ล้วนอยู่แล้ว
model RoleModuleAccess {
  id       Int    @id @default(autoincrement())
  role     String
  moduleId Int
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([role, moduleId])
}